# ---- copy this file to ".env" and fill in ----

# ===== Claude (AI reader) =====
# Anthropic API key (console.anthropic.com) – required for photo & voice reading.
# In multi-user mode the administrator can also paste the key in Administration > Integrations
# (stored encrypted) – then this line may stay empty.
ANTHROPIC_API_KEY=sk-ant-...

# live = call Claude; mock = offline demo using fixtures/mock_extractions
AE_EXTRACTOR_MODE=live
AE_CLAUDE_MODEL=claude-sonnet-5
# AE_CLAUDE_FALLBACK_MODELS=claude-sonnet-4-5,claude-opus-5-5,claude-haiku-4-5-20251001

# ===== Business defaults (used for new accounts / single-user mode) =====
AE_BUSINESS_NAME=Wings Industries
AE_DEFAULT_STATE=Assam
AE_DEFAULT_COUNTRY=India
AE_BILL_NO_PREFIX=WI

# Where the database, bill images and exports live (default: ./data ; Docker: /app/data)
# AE_DATA_DIR=C:\Users\you\Documents\AccountingEngine\data

# ===== Accounts & subscriptions (multi-user service) =====
# off  = single-user laptop mode, no login (everything under data/)
# on   = login required; each account gets its own private folder under data/tenants/
# auto = (default) off until an administrator account exists or AE_ADMIN_EMAIL is set
AE_AUTH=auto

# First administrator – created automatically on first start if no admin exists yet.
# (Alternative: leave empty and use the one-time setup token printed in the server log.)
# AE_ADMIN_EMAIL=you@example.com
# AE_ADMIN_PASSWORD=change-me-now

# Key that encrypts stored secrets (Claude / Razorpay keys). Generate once and KEEP IT:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated on first start and kept in data/master.key (back that file up!).
# AE_SECRET_KEY=

# Session cookie "Secure" flag: auto = on when served over https (Caddy/nginx/AE_HTTPS), on / off to force.
AE_COOKIE_SECURE=auto
# Set to 1 ONLY when a reverse proxy you control (Caddy/nginx) sits in front: client addresses for the
# login throttle are then read from X-Forwarded-For. docker-compose.domain.yml sets it automatically.
# AE_TRUST_PROXY=1

# ===== Domain (docker compose with Caddy: docker-compose.domain.yml) =====
# DOMAIN=bills.example.com
# ACME_EMAIL=you@example.com
