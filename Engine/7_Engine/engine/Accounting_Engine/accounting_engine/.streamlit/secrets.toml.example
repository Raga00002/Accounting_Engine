# Copy to .streamlit/secrets.toml to enable "Continue with Google" on the sign-in page.
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorised redirect URI:  https://YOUR-DOMAIN/oauth2callback   (must match redirect_uri below)
# Keep this file private (it is in .gitignore / .dockerignore; mount it read-only in Docker).

[auth]
redirect_uri = "https://bills.example.com/oauth2callback"
# any long random string – signs Streamlit's own login cookie:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "CHANGE-ME-random-string"

[auth.google]
client_id = "1234567890-xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
